# 复制为 .env 后填写；.env 不要提交仓库
BOTNAME=DSH
APPID=
APPSECRET=

# 主人 QQ 的 openid（留空则首次单聊自动认领并写回 bot/state.json）
OWNER_OPENID=

# DSH 插件 dsh-qq-bridge 的本地回环地址与令牌（令牌须与 profile 里 qq-bridge 条目的 token 一致）
BRIDGE_URL=http://127.0.0.1:39061
BRIDGE_TOKEN=

# 运行参数
QQ_SANDBOX=0
GROUP_ENABLED=1
# 群消息全量模式：能看到每条群消息（只做上下文，不逐条回），并低频插话
GROUP_FULL_MODE=1
GROUP_CHIME_MIN=8
GROUP_CHIME_COOLDOWN=240
# 群主身份走平台接口校验（内邀能力未开通时退回 /绑定）
OWNER_ROLE_CHECK=1
HTTP_TIMEOUT=60
MAX_CHARS=1600
PULL_WAIT_MS=25000
ACK_DELAY_S=12
ACK_TEXT=（还在处理，请稍等…）
# 连续消息合并：安静 1.8s 或最长 6s 后合成一条
DEBOUNCE_MS=1800
DEBOUNCE_MAX_MS=6000
# 回复里出现 Markdown 就用 msg_type=2 的 MD 消息发
MD_AUTO=1
IMAGE_MAX_MB=8
