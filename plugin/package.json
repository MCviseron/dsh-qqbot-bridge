{
  "name": "dsh-qq-bridge",
  "version": "0.3.4",
  "description": "DeepSeek Harness plugin: bridge QQ conversations (driven by an external viseron-botpy bot) to DSH sessions — injects user messages, captures assistant replies, streams C2C answers, and relays tool approvals to the bot owner.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bot",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "prepack": "node scripts/pack-bot.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCviseron/dsh-qqbot-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/MCviseron/dsh-qqbot-bridge/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "qq",
    "qqbot",
    "bridge",
    "streaming"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
